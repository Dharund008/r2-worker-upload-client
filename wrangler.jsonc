{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ap-r2-upload-client",
  "main": "src/index.js",
  "compatibility_date": "2026-08-06",
  "preview_urls": false,

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "apmultimedianewsroom-dev"
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "TEAM_DOMAIN": "https://dawn-pond-66c2.cloudflareaccess.com",
    "POLICY_AUD": "fc6dee6a43291920a74745da151b1dac0b7888850fcc4433a182bfde98c7a275",
    "UPLOAD_PREFIX": "",
    "REQUIRE_ACCESS": "true",
    "CUSTOMER_NAME": "Associated Press",
    "R2_BUCKET_NAME": "apmultimedianewsroom-dev",
    "CF_ACCOUNT_ID": "d21c98f955db4c56132c2fc104a8c966",
    "PUBLIC_BASE_URL": "https://download.apmultimedianewsroom.com"
  },

  "observability": {
    "enabled": true
  },

  "env": {
    "dev": {
      "name": "ap-r2-upload-client",
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "apmultimedianewsroom-dev"
        }
      ],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "TEAM_DOMAIN": "https://dawn-pond-66c2.cloudflareaccess.com",
        "POLICY_AUD": "fc6dee6a43291920a74745da151b1dac0b7888850fcc4433a182bfde98c7a275",
        "UPLOAD_PREFIX": "",
        "REQUIRE_ACCESS": "true",
        "CUSTOMER_NAME": "Associated Press",
        "R2_BUCKET_NAME": "apmultimedianewsroom-dev",
        "CF_ACCOUNT_ID": "d21c98f955db4c56132c2fc104a8c966",
        "PUBLIC_BASE_URL": "https://download.apmultimedianewsroom.com"
      },
      "observability": {
        "enabled": true
      }
    },
    "production": {
      "name": "ap-r2-upload-client-prod",
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "apmultimedianewsroom-prod"
        }
      ],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "TEAM_DOMAIN": "https://dawn-pond-66c2.cloudflareaccess.com",
        "POLICY_AUD": "4fab8c2cc7c33f74debf741d9311c55f5e17dc29ae822526862bf8ac3f9faf7a",
        "UPLOAD_PREFIX": "",
        "REQUIRE_ACCESS": "true",
        "CUSTOMER_NAME": "Associated Press",
        "R2_BUCKET_NAME": "apmultimedianewsroom-prod",
        "CF_ACCOUNT_ID": "d21c98f955db4c56132c2fc104a8c966",
        "PUBLIC_BASE_URL": "https://download.apmultimedianewsroom.com"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
